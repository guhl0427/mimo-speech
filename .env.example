# Optional for real MiMo calls. You can also save a key in the in-app Settings
# dialog (stored in data/settings.json, which overrides this value).
MIMO_API_KEY=

# Optional: override the MiMo API base URL
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Server port
PORT=8787

# Development only: return local mock audio/transcript without calling MiMo.
# Keep 0 for real usage.
MOCK_MIMO=0
